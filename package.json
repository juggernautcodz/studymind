    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.10",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "~55.0.19",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.21",
    "expo-print": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.14",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "i18n-js": "^4.5.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "openai": "^6.16.0",
