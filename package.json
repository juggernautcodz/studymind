{
  "name": "my-app",
  "main": "client/index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "expo:dev": "EXPO_NO_PROMPT=1 EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.cjs",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=server_dist/index.mjs",
    "server:prod": "NODE_ENV=production node server_dist/index.mjs",
    "prod:boot:test": "node scripts/prod-boot-test.cjs",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "check": "npm run check:types && npm run lint && npm run check:format",
    "fix": "npm run lint:fix && npm run format",
    "dev": "npm run server:dev",
    "start": "npm run expo:dev",
    "prod": "npm run server:prod",
    "dev:all": "npm run server:dev & npm run expo:dev",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "audit": "node scripts/audit.cjs",
    "audit:fast": "AUDIT_SKIP_BUILD=1 node scripts/audit.cjs",
    "test:exam-readiness": "tsx --test server/exam-readiness.test.ts",
    "test:exam-readiness-client": "tsx --test client/lib/examReadinessPresentation.test.ts",
    "mobile:recover": "bash scripts/mobile-recover.sh",
    "preflight:mobile": "node scripts/preflight-check.cjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.3.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/elements": "^2.9.1",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@tanstack/react-query": "^5.90.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/react": "~19.2.10",
    "@types/uuid": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~55.0.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.0",
    "expo": "~55.0.18",
    "expo-asset": "~55.0.8",
    "expo-audio": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.17",
    "expo-clipboard": "~55.0.13",
